      "type": "FAQ",
      "label": "WFM schedules not updating",
      "properties": {
        "faq_id": "FAQ-004",
        "tenant_id": "tenant_demo",
        "question": "Forecast updated but schedules did not regenerate — what should I do?",
        "answer": "Check WFM Jobs status, confirm schedule regen backlog, clear orchestration lock if stale, then re-trigger regen. If still stuck, restart orchestration worker and run the recovery runbook.",
        "created_at": "2026-02-26T00:00:00+00:00",
        "updated_at": "2026-02-26T00:00:00+00:00"
      },
      "tags": ["WFM", "Schedule", "Regen"]
    },
    {
      "id": "RB-004",
      "type": "Runbook",
      "label": "WFM Forecast→Schedule Regen Recovery",
      "properties": {
        "runbook_id": "RB-004",
        "tenant_id": "tenant_demo",
        "category": "Incident Recovery",
        "estimated_time": "25 minutes",
        "steps": [
          "1. Confirm WFM job backlog in Admin Center → WFM → Jobs",
          "2. Check Dataverse async jobs for schedule regen waiting/stuck",
          "3. Inspect orchestration lock entity for stale owner/timestamp",
          "4. Clear lock and re-trigger schedule regeneration",
